/* ── groket theme ──────────────────────────────────────────────────────── */

Screen {
    background: $surface;
}

/* Modals: dim the stack underneath (translucent overlay) so the prior screen
   remains visible — dialog bodies stay opaque ($surface / $panel). */
ModalScreen {
    align: center middle;
    background: $background 32%;
}

ModalScreen:ansi {
    background: transparent;
}

/* Multiline editors: tall border uses 1 row top+bottom; keep ≥2 content lines
   so Enter does not look like the field was cleared. */
TextArea {
    min-height: 4;
}

/* ── Header / Footer ──────────────────────────────────────────────────── */

ActivityBar,
#activity-bar {
    dock: none;
    height: 1;
    width: 1fr;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
    content-align: right middle;
    text-align: right;
}

Footer {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

Footer FooterKey .footer-key--key {
    color: $text;
    text-style: bold;
    padding: 0;
}

Footer FooterKey .footer-key--description {
    color: $text-muted;
    padding: 0 0 0 1;
}

Footer KeyGroup.-compact {
    margin: 0 1 0 0;
    padding-left: 1;
    border-left: vkey $secondary;
}

Footer FooterKey.-command-palette {
    border-left: vkey $secondary;
    padding-right: 0;
}

/* ── Self-test modal ─────────────────────────────────────────────────── */

#self-test-modal {
    width: 72;
    height: auto;
    max-height: 90%;
    layout: vertical;
    padding: 1 2;
    background: $surface;
    border: thick $primary;
}

#self-test-title {
    text-style: bold;
    margin-bottom: 1;
}

#self-test-body {
    height: 1fr;
    min-height: 3;
    max-height: 28;
    overflow-y: auto;
    margin-bottom: 0;
}

#self-test-actions {
    dock: bottom;
    height: auto;
    min-height: 3;
    align: left middle;
    padding: 1 0 0 0;
    background: $surface;
}

#self-test-actions Button {
    margin-right: 1;
}

/* ── Trace Browser ────────────────────────────────────────────────────── */

#browser-tabs {
    height: 1fr;
}

TabPane {
    height: 1fr;
    layout: vertical;
}

#browser-layout {
    layout: horizontal;
    height: 1fr;
}

#timeline-panel {
    width: 3fr;
    height: 1fr;
    layout: vertical;
    border-right: solid $primary-lighten-2;
}

#detail-column {
    width: 2fr;
    height: 1fr;
    layout: vertical;
}

#detail-panel {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

#browser-layout.event-reader #timeline-panel {
    width: 0;
    min-width: 0;
    overflow: hidden;
    border: none;
}

#browser-layout.event-reader #detail-column {
    width: 1fr;
}

#timeline-list {
    height: 1fr;
    min-height: 5;
}

/* ── Analysis settings modal ─────────────────────────────────────────── */

#analysis-settings-modal {
    width: 72;
    height: auto;
    max-height: 90%;
    layout: vertical;
    padding: 1 2;
    background: $surface;
    border: solid $primary;
}

#analysis-settings-title {
    text-style: bold;
    margin-bottom: 1;
}

#analysis-settings-help {
    color: $text-muted;
    margin-bottom: 1;
}

#analysis-settings-modal Select {
    width: 100%;
    margin-bottom: 1;
}

#analysis-settings-actions {
    dock: bottom;
    height: auto;
    min-height: 3;
    align: right middle;
    padding: 1 0 0 0;
    background: $surface;
}

#interactive-sessions-modal {
    width: 72;
    height: auto;
    max-height: 90%;
    layout: vertical;
    padding: 1 2;
    background: $surface;
    border: solid $primary;
}

#interactive-modal-title {
    text-style: bold;
    margin-bottom: 1;
}

#interactive-follow-input {
    width: 100%;
    margin-bottom: 0;
}

#interactive-follow-last-turn {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

#interactive-modal-actions {
    dock: bottom;
    height: auto;
    min-height: 3;
    align: right middle;
    padding: 1 0 0 0;
    background: $surface;
}

#analysis-settings-actions Button {
    margin-left: 1;
}

/* ── Session load bar (main screen) ───────────────────────────────────── */
/* Do not force height: 1 on toolbars that contain Input/Button — clips chrome. */

#session-paths {
    padding: 0 1;
    height: 1;
    color: $text-muted;
}

#session-summary {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

/* ── Shared filter bars (sessions, Timeline, Report) ─────────────────── */
/* Sit in the vertical stack (not dock: top) so TabPane layout is stable.   */
/* See widgets/controls.py — label + Select, never chips. */

#session-filter-bar,
#filter-bar,
#report-filter-bar,
.filter-bar {
    height: auto;
    min-height: 3;
    width: 100%;
    padding: 0 1;
    layout: horizontal;
    align: left middle;
    background: $surface;
    border-bottom: solid $primary-background;
}

#filter-view-label,
.filter-view-label {
    width: auto;
    height: auto;
    min-height: 3;
    content-align: left middle;
    padding: 0 1 0 0;
    text-style: bold;
    color: $text;
}

/* Timeline View — short option labels (All events, Tools only, …). */
#timeline-view-select {
    width: 24;
    min-width: 20;
    max-width: 32;
    height: auto;
    margin: 0 1 0 0;
}

/* Sessions list — Model + Task selects (orthogonal filters). */
#session-model-select,
.session-filter-select {
    width: 1fr;
    min-width: 16;
    max-width: 40;
    height: auto;
    margin: 0 1 0 0;
}

/* Report Filter — long plugin names (Security Scanner (2), Feedback (report), …). */
#report-view-select,
.report-view-select {
    width: 1fr;
    min-width: 28;
    max-width: 72;
    height: auto;
    margin: 0 1 0 0;
}

#timeline-view-select > SelectCurrent,
#session-model-select > SelectCurrent,
.session-filter-select > SelectCurrent,
#report-view-select > SelectCurrent,
.report-view-select > SelectCurrent {
    background: $boost;
    border: solid $primary;
    color: $text;
    height: auto;
    min-height: 3;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#report-view-select > SelectCurrent,
.report-view-select > SelectCurrent,
#session-model-select > SelectCurrent,
.session-filter-select > SelectCurrent {
    /* Prefer full labels; bar already allows wide select */
    width: 100%;
}

#timeline-view-select:focus > SelectCurrent,
#session-model-select:focus > SelectCurrent,
.session-filter-select:focus > SelectCurrent,
#report-view-select:focus > SelectCurrent,
.report-view-select:focus > SelectCurrent {
    border: solid $accent;
    background: $surface-lighten-1;
}

/* Dropdown list options should not squeeze plugin names either */
#report-view-select > SelectOverlay,
.report-view-select > SelectOverlay,
#session-model-select > SelectOverlay,
.session-filter-select > SelectOverlay {
    min-width: 100%;
    width: auto;
    max-width: 80;
}

#timeline-tail-label {
    width: auto;
    height: 3;
    min-height: 3;
    content-align: left middle;
    padding: 0 1 0 0;
    margin: 0 0 0 1;
}

/* 3-row slot so the bar can middle-align a 1-row Switch (no pad). */
#timeline-tail-slot {
    width: 8;
    height: 3;
    min-height: 3;
    max-height: 3;
    layout: vertical;
    align: center middle;
}

#timeline-tail {
    width: 8;
    height: 1;
    min-height: 1;
    max-height: 1;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

#filter-bar Input,
#session-filter-bar Input {
    width: 1fr;
    height: auto;
    min-height: 3;
    border: solid $primary-background;
    padding: 0 1;
    margin: 0 0 0 1;
    background: $surface-darken-1;
    color: $text;
}

#filter-bar Input:focus,
#session-filter-bar Input:focus {
    border: solid $accent;
    background: $surface;
}

/* Report — one scroll, inline panels; Filter = Select (same as Timeline). */
#reports-panel {
    height: 1fr;
    layout: vertical;
}

#reports-scroll {
    height: 1fr;
}

#report-sections-host {
    height: auto;
    width: 100%;
    layout: vertical;
}

.report-section {
    height: auto;
}

/* Plugin report: one focusable SelectableStatic per logical pane (H2 / Issue). */
.report-pane {
    height: auto;
    width: 100%;
    margin: 0 0 1 0;
    padding: 0 0 0 0;
    background: transparent;
    border: none;
    color: $text;
}

/* Report panes stay focusable for Tab + y; no raise chrome on click/focus. */

/* ── Selects — natural height, light chrome (no height:1 clipping) ───── */

Select {
    height: auto;
    margin: 0 0 1 0;
}

Select > SelectCurrent {
    height: auto;
    min-height: 3;
    background: $surface;
    border: solid $primary-background;
    color: $text;
    padding: 0 1;
}

Select > SelectCurrent Static#label {
    color: $text;
    background: transparent;
}

Select > SelectCurrent .arrow {
    color: $text-muted;
}

Select:focus > SelectCurrent {
    border: solid $accent;
    background: $surface-lighten-1;
}

/* Pop-up list must beat Textual's ``Select > SelectOverlay { border: tall
 * $border-blurred }`` (higher specificity than a bare SelectOverlay rule).
 * Dark heavy outer border + accent outline = cutout over table rows. */
Select > SelectOverlay,
Select.-expanded > SelectOverlay,
SelectOverlay {
    /* Solid panel — not translucent over zebra rows. */
    background: $boost !important;
    /* Outside: opaque black frame (stronger than theme “darken” tokens). */
    border: heavy #000000 !important;
    /* Inside rim: accent (yellow on many themes) — Textual outline sits on the widget. */
    outline: tall $accent !important;
    padding: 1 2;
    max-height: 12;
    /* Kill inherited tint/blur that made the menu look like another list row. */
    background-tint: $foreground 0%;
}

Select > SelectOverlay:focus,
SelectOverlay:focus {
    border: heavy #000000 !important;
    outline: wide $accent !important;
    background: $boost !important;
}

/* Options: padding + highlight clearly unlike DataTable cursor/zebra. */
Select > SelectOverlay > .option-list--option,
SelectOverlay > .option-list--option {
    padding: 0 1;
    background: transparent;
}

Select > SelectOverlay > .option-list--option-highlighted,
SelectOverlay > .option-list--option-highlighted,
Select > SelectOverlay:focus > .option-list--option-highlighted,
SelectOverlay:focus > .option-list--option-highlighted {
    background: $accent !important;
    color: $background !important;
    text-style: bold;
}

#runner-main Select,
#persona-editor-shell Select,
#analysis-settings-modal Select {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

#persona-row Select {
    width: 1fr;
    height: auto;
    margin: 0 1 0 0;
}

#persona-row {
    height: auto;
    min-height: 3;
    align: left middle;
}

.field-select {
    min-width: 16;
}

/* ── Detail View ──────────────────────────────────────────────────────── */

#detail-content {
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
}

#detail-header {
    height: auto;
    padding: 1 2;
    background: $panel;
    border-bottom: solid $primary-lighten-2;
}

.event-badge {
    padding: 0 1;
    margin: 0 1;
}

.event-badge-user {
    background: $success;
    color: $text;
}

.event-badge-assistant {
    background: $primary;
    color: $text;
}

.event-badge-thought {
    background: $surface-lighten-2;
    color: $text-muted;
}

.event-badge-tool_call {
    background: $accent;
    color: $text;
}

.event-badge-tool_result {
    background: $warning;
    color: $text;
}

.event-badge-error {
    background: $error;
    color: $text;
    text-style: bold;
}

.event-badge-plan {
    background: $warning;
    color: $text;
}

.event-badge-subagent {
    background: $warning;
    color: $text;
}

/* ── Issues Panel ─────────────────────────────────────────────────────── */

#issues-list {
    height: 1fr;
}

.issue-row {
    height: auto;
    padding: 1 2;
    border-bottom: solid $surface-lighten-1;
}

.issue-row:hover {
    background: $boost;
}

.severity-high {
    color: $error;
    text-style: bold;
}

.severity-medium {
    color: $warning;
}

.severity-low {
    color: $text-muted;
}

/* ── Flag Panel ───────────────────────────────────────────────────────── */

#flag-form {
    padding: 1 2;
    height: auto;
}

#flag-form TextArea {
    height: 6;
    min-height: 4;
    margin: 1 0;
}

/* Pending interactive / live session controls (browser; hidden when settled) */
#session-pending-bar {
    display: none;
    height: auto;
    min-height: 3;
    max-height: 8;
    padding: 0 1;
    background: $boost;
    border-bottom: tall $primary;
}

#session-pending-queue {
    color: $text-muted;
    padding: 0 1;
    height: auto;
    max-height: 8;
}

#session-pending-status {
    height: auto;
}

#session-follow-input {
    width: 100%;
}

#session-pending-actions {
    height: 3;
    align: left middle;
}

#session-pending-actions Button {
    margin-right: 1;
}

/* ── Runner Screen (tabbed recipe — not one scroll wall) ──────────────── */

#runner-screen {
    height: 1fr;
    layout: vertical;
    /* Keep action bar clear of Footer; toolbar is in-flow (not dock:bottom). */
    padding-bottom: 1;
}

#runner-main {
    height: 1fr;
    layout: vertical;
    padding: 0 2 0 2;
}

#path-input-modal {
    width: 70;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: tall $primary;
}

#path-input-title {
    text-style: bold;
    margin-bottom: 1;
}

#path-input-hint {
    color: $text-muted;
    margin-bottom: 1;
}

#path-input-field {
    width: 100%;
    margin-bottom: 1;
}

#path-input-actions {
    height: auto;
    align-horizontal: right;
}

#path-input-actions Button {
    margin-left: 1;
}

#discard-confirm-modal {
    width: 56;
    height: auto;
    max-height: 90%;
    layout: vertical;
    padding: 1 2;
    background: $surface;
    border: thick $warning;
}

#discard-confirm-title {
    margin: 0 0 1 0;
}

#discard-confirm-body {
    margin: 0 0 1 0;
    color: $text-muted;
}

#discard-confirm-actions {
    dock: bottom;
    height: auto;
    min-height: 3;
    align: left middle;
    padding: 1 0 0 0;
    background: $surface;
}

#discard-confirm-actions Button {
    margin-right: 1;
}

#runner-title {
    height: 1;
    margin: 0;
}

#runner-tabs {
    height: 1fr;
    min-height: 8;
}

#runner-main .runner-pane {
    height: 1fr;
    padding: 0 1 0 0;
}

#runner-main Label {
    margin: 0;
    height: 1;
    text-style: bold;
}

#runner-main .runner-field-hint {
    height: auto;
    margin: 0;
    color: $text-muted;
}

/* Status lines take no space until shown (display toggled in code). */
#runner-main .runner-launch-panel {
    width: 100%;
    margin: 0 0 1 0;
    padding: 0 1;
    color: $text-muted;
    border-left: wide $primary;
}

#runner-main .runner-status-line {
    height: auto;
    margin: 0;
    color: $text-muted;
}

#runner-main .runner-inline-row {
    height: auto;
    width: 100%;
    margin: 0;
}

#runner-main .runner-col {
    width: 1fr;
    height: auto;
    margin: 0 1 0 0;
}

#runner-main .runner-col:last-child {
    margin-right: 0;
}

#runner-main #repo-row .runner-repo-url {
    width: 1fr;
    margin-right: 1;
}

#runner-main #repo-row .runner-repo-branch {
    width: 18;
    min-width: 12;
    max-width: 24;
}

#runner-main Input,
#runner-main Select {
    margin: 0 0 0 0;
    width: 100%;
    height: 3;
}

#runner-main TextArea {
    margin: 0;
    height: 5;
    min-height: 4;
    width: 100%;
}

#runner-main TextArea.runner-setup {
    height: 4;
    min-height: 4;
}

#runner-main SelectionList,
#models-select {
    height: 1fr;
    min-height: 4;
    max-height: 16;
    margin: 0;
    width: 100%;
    border: solid $primary-lighten-2;
}

/* Action bar above Footer (not dock:bottom — avoids clipping under Footer). */
#runner-toolbar {
    height: auto;
    min-height: 1;
    width: 100%;
    margin: 0;
    padding: 0 1;
    background: $surface-darken-1;
    border-top: solid $primary-lighten-2;
    align: left middle;
    layout: horizontal;
}

#runner-toolbar-primary {
    width: auto;
    height: auto;
    min-height: 1;
    align: left middle;
}

#runner-toolbar Button {
    margin-right: 1;
    min-width: 8;
}

#runner-status-panel {
    height: auto;
    max-height: 12;
    padding: 0 1 0 0;
    border-top: solid $primary-background;
}

#run-mcp-search {
    width: 100%;
    margin: 0;
}

#persona-row {
    height: auto;
    width: 100%;
}

#persona-row Select {
    width: 1fr;
}

#persona-row .runner-inline-btn {
    width: auto;
    min-width: 6;
    margin-left: 1;
}

#run-caps-actions {
    height: 3;
    align: left middle;
    margin-bottom: 1;
}

#run-caps-actions Button {
    margin-right: 1;
}

#run-caps-persona-hint,
#run-caps-help {
    margin-bottom: 1;
}

#run-caps-summary {
    margin-bottom: 1;
    padding: 1;
    background: $surface-lighten-1;
    border: solid $success;
    height: auto;
    min-height: 3;
    max-height: 16;
    overflow-y: auto;
}


/* MCP / skills / plugins pickers — footer stays visible; table takes remaining height */
#plugins-picker-modal,
#mcp-picker-modal,
#skills-picker-modal {
    width: 88;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    layout: vertical;
    padding: 0 2 0 2;
    background: $surface;
    border: heavy $primary;
}

#mcp-picker-modal #mcp-pick-title,
#skills-picker-modal #skills-pick-title,
#plugins-picker-modal #plugins-pick-title {
    height: auto;
    margin: 0;
    /* title / tips / search stay compact — never steal space from the footer */
}

#mcp-picker-modal #mcp-pick-search,
#skills-picker-modal #skills-pick-search,
#plugins-picker-modal #plugins-pick-search {
    width: 100%;
    margin: 0;
    height: 3;
}

#mcp-picker-modal #mcp-pick-search-row {
    height: auto;
    align: left middle;
    margin: 0;
}

/* Shrinkable middle: table fills leftover space under max-height */
#mcp-picker-modal #mcp-pick-table,
#skills-picker-modal #skills-pick-table,
#plugins-picker-modal #plugins-pick-table {
    height: 1fr;
    min-height: 3;
    margin: 0;
}

#mcp-picker-modal #mcp-pick-detail,
#plugins-picker-modal #plugins-pick-detail {
    height: auto;
    min-height: 1;
    max-height: 5;
    overflow-y: auto;
    margin: 0;
    padding: 0 1;
    background: $surface-darken-1;
    border: solid $primary-lighten-2;
    color: $text;
}

#mcp-picker-modal #mcp-pick-status,
#mcp-picker-modal #mcp-pick-sel,
#skills-picker-modal #skills-pick-sel,
#plugins-picker-modal #plugins-pick-sel {
    margin: 0;
    height: auto;
    min-height: 1;
}

/* Always visible Done/Cancel */
#mcp-picker-modal #mcp-pick-footer,
#skills-picker-modal #skills-pick-footer,
#plugins-picker-modal #plugins-pick-footer {
    dock: bottom;
    height: auto;
    min-height: 3;
    align: left middle;
    margin: 0;
    padding: 1 0;
    background: $surface;
}

/* Form modals: scrollable body + docked footer (buttons always visible) */
#env-editor-modal,
#inline-skill-modal,
#mcp-cfg-modal {
    width: 80;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    layout: vertical;
    padding: 0 2 0 2;
    background: $surface;
    border: tall $primary;
}

#mcp-cfg-modal {
    border: heavy $primary;
}

#env-editor-modal #env-editor-body,
#inline-skill-modal #inline-skill-body-scroll,
#mcp-cfg-modal #mcp-cfg-body {
    height: 1fr;
    min-height: 4;
    overflow-y: auto;
    padding: 1 0;
}

#env-editor-modal #env-editor-title,
#inline-skill-modal #inline-skill-title {
    text-style: bold;
    margin-bottom: 1;
}

#inline-skill-modal TextArea.pe-tall {
    height: 12;
    min-height: 6;
    max-height: 16;
}

#mcp-cfg-modal TextArea {
    height: 3;
    min-height: 3;
    max-height: 6;
    width: 100%;
    margin: 0;
}

#env-editor-modal #env-editor-footer,
#inline-skill-modal #inline-skill-footer,
#mcp-cfg-modal #mcp-cfg-footer {
    dock: bottom;
    height: auto;
    min-height: 3;
    align: left middle;
    margin: 0;
    padding: 1 0;
    background: $surface;
}

#runner-status-panel #container-status-table {
    height: 8;
    min-height: 5;
    max-height: 12;
    margin-top: 0;
}

#github-write-bar {
    height: 3;
    width: 100%;
    align: left middle;
}

/* Booleans: label + [ ] / [x]. Room for focus border so the label never clips. */
Checkbox {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $boost;
    color: $text;
    border: tall $panel;
}

Checkbox:focus {
    background: $primary 20%;
    color: $text;
    text-style: bold;
    border: tall $accent;
}

Checkbox.-on {
    color: $success;
    background: $boost;
    text-style: bold;
}

Checkbox.-on:focus {
    color: $success;
    background: $primary 20%;
    border: tall $accent;
}

/* Legacy Switch (if any remain): keep compact, don't inflate to 3 rows */
Switch {
    width: auto;
    height: 1;
    min-width: 7;
    background: $panel;
    border: none;
    padding: 0 1;
    margin: 0 0 0 1;
}

Switch .switch--slider {
    background: $surface-darken-1;
    color: $text-muted;
}

Switch.-on .switch--slider {
    color: $success;
    background: $success 20%;
}

.switch-row,
.pe-switch-row,
#github-write-bar {
    height: auto;
    width: 100%;
    align: left middle;
    margin: 0;
}

#models-override-modal, #batch-launch-modal {
    width: 72;
    height: auto;
    max-height: 90%;
    layout: vertical;
    padding: 1 2;
    background: $surface;
    border: heavy $primary;
}

#models-override-modal #mom-models,
#batch-launch-modal #blm-models {
    height: 1fr;
    min-height: 4;
    max-height: 16;
    overflow-y: auto;
}

#models-override-modal #mom-footer,
#batch-launch-modal #blm-footer {
    dock: bottom;
    height: auto;
    min-height: 3;
    align: left middle;
    padding: 1 0 0 0;
    background: $surface;
}

/* Persona editor — tabbed, not a single scroll wall (backdrop via ModalScreen) */
PersonaEditorModal {
    align: center middle;
}

#persona-editor-shell {
    width: 88;
    max-width: 96%;
    height: 72%;
    max-height: 82%;
    layout: vertical;
    background: $surface;
    border: heavy $primary;
    padding: 0 2 1 2;
}

#pe-title {
    height: auto;
    margin: 0;
}

#pe-tabs {
    height: 1fr;
    min-height: 8;
}

#persona-editor-shell .pe-pane {
    height: 1fr;
    padding: 0 1 0 0;
}

#persona-editor-shell Label {
    margin: 0;
    height: 1;
    text-style: bold;
}

#persona-editor-shell .pe-field-hint {
    height: auto;
    margin: 0;
    color: $text-muted;
}

#persona-editor-shell Input,
#persona-editor-shell Select {
    margin: 0;
    width: 100%;
    height: 3;
}

#persona-editor-shell TextArea {
    margin: 0;
    height: 3;
    min-height: 3;
    width: 100%;
}

#persona-editor-shell TextArea.pe-medium {
    height: 4;
    min-height: 3;
}

#persona-editor-shell TextArea.pe-tall {
    height: auto;
    min-height: 4;
    max-height: 8;
}

#persona-editor-shell .pe-inline-row {
    height: auto;
    width: 100%;
}

#persona-editor-shell .pe-inline-row > Vertical {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

#persona-editor-shell .pe-inline-row > Vertical:last-child {
    margin-right: 0;
}

#persona-editor-shell .pe-switch-row {
    height: 3;
    align: left middle;
    margin: 1 0 0 0;
}

#persona-editor-shell .pe-btn-row {
    height: 3;
    align: left middle;
    margin: 0 0 1 0;
}

#pe-actions {
    height: 3;
    dock: bottom;
    align: left middle;
    margin-top: 1;
    padding-top: 0;
}

#pe-actions Button {
    margin-right: 1;
}

#pe-gh-row {
    height: 3;
    align: left middle;
    margin: 0 0 0 0;
}

#personas-screen {
    padding: 1 2;
}

#pb-detail {
    margin: 1 0;
    height: auto;
    min-height: 4;
    border: solid $primary-lighten-2;
    padding: 1;
}

#pb-actions {
    height: 3;
    margin-top: 1;
}

#pb-actions Button {
    margin-right: 1;
}

#persona-row {
    height: 3;
    width: 100%;
    align: left middle;
}

#persona-row Select {
    width: 1fr;
    margin: 0 1 0 0;
}

#persona-row .runner-inline-btn {
    min-width: 8;
    margin: 0 0 0 1;
    height: 3;
}

#models-override-modal SelectionList, #batch-launch-modal SelectionList,
#mom-models, #blm-models {
    height: 12;
    min-height: 6;
    border: solid $primary-lighten-2;
    margin: 1 0;
}

#docker-profile-hint {
    margin-bottom: 1;
    color: $text-muted;
}

#run-banner {
    padding: 1 2;
    margin: 1 0 1 0;
    height: auto;
    border: solid $primary-lighten-2;
    background: $surface-darken-1;
}

#container-status {
    padding: 1 2;
    height: 1fr;
    border-top: solid $primary;
}

/* Runner: compact status only (full logs in Jobs modal) */
#container-status-table {
    height: auto;
    max-height: 12;
    margin: 0 1 1 1;
}

#jobs-modal {
    width: 96;
    height: 90%;
    max-height: 48;
    layout: vertical;
    padding: 1 2;
    border: heavy $primary;
    background: $surface;
    margin: 1 2;
}

#jobs-modal-title {
    height: auto;
    margin-bottom: 1;
}

#jobs-app-status {
    height: auto;
    padding: 0 0 1 0;
}

#jobs-tabs {
    height: 1fr;
    min-height: 8;
}

#jobs-status-table, #jobs-history-table {
    height: auto;
    max-height: 14;
    margin: 0 0 1 0;
}

#jobs-logs-tabs {
    height: 1fr;
    min-height: 8;
    border: solid $primary-lighten-2;
    background: $surface-darken-1;
}

#jobs-logs-tabs RichLog {
    height: 1fr;
    background: $surface-darken-1;
    padding: 0 1;
    scrollbar-size: 1 1;
}

#jobs-modal-actions {
    dock: bottom;
    height: auto;
    min-height: 3;
    padding: 1 0 0 0;
    background: $surface;
}

#jobs-modal-actions Button {
    margin-right: 1;
}

/* ── Rule Manager ─────────────────────────────────────────────────────── */

#rule-list {
    height: 1fr;
    padding: 1 2;
}

.rule-row {
    height: 3;
    padding: 0 2;
}

.rule-row:hover {
    background: $boost;
}

.rule-enabled {
    color: $success;
}

.rule-disabled {
    color: $text-muted;
}

/* ── Tabs ─────────────────────────────────────────────────────────────── */

ContentSwitcher {
    height: 1fr;
}

/* ── Feedback tab (BTNB cache: report / evidence / prompt) ─────────────── */

#feedback-panel {
    height: 1fr;
    layout: vertical;
}

#feedback-bar {
    height: 3;
    padding: 0 1;
    layout: horizontal;
    background: $surface-darken-1;
}

#feedback-bar Button {
    min-width: 0;
    margin: 0 1 0 0;
    padding: 0 1;
    height: 1;
    background: transparent;
    color: $text-muted;
    border: none;
}

#feedback-bar Button.active {
    color: $accent;
    background: transparent;
    text-style: bold;
}

#feedback-bar Button:hover {
    color: $text;
    background: transparent;
    text-style: underline;
}

#feedback-bar Button:focus {
    background: transparent;
    text-style: underline;
}

#feedback-actions {
    height: 3;
    padding: 0 1;
    layout: horizontal;
    background: $surface-darken-1;
}

#feedback-actions Button {
    min-width: 0;
    margin: 0 1 0 0;
    padding: 0 1;
    height: 1;
}

.feedback-status {
    height: auto;
    max-height: 8;
    padding: 0 1 1 1;
    border-bottom: solid $surface-lighten-1;
    color: $text-muted;
}

#feedback-scroll {
    height: 1fr;
}

#feedback-content {
    padding: 1 2;
    height: auto;
}

/* Shared card frame for non-table blocks AND table hosts (matches DataTable border) */
.panel-card {
    height: auto;
    layout: vertical;
    background: $surface;
    border: solid $primary-background;
    padding: 1;
    margin: 0 0 1 0;
    color: $text;
}

.panel-card-grow {
    height: 1fr;
    min-height: 8;
    margin-bottom: 0;
}

.panel-card-title {
    height: auto;
    padding: 0 0 1 0;
    text-style: bold;
    color: $text;
}

/* Content sits inside .panel-card — no second border on the Static */
#summary-content,
#reports-content,
#diff-content,
#diff-prompt,
#diff-assistant,
#findings-header,
#report-overview-content,
#report-flags-content,
#report-notes-content {
    height: auto;
    padding: 0;
    color: $text;
    background: transparent;
    border: none;
}

/* Extractable bodies stay focusable for Tab + y; no raise chrome on click. */

/* Scroll hosts: page background; cards provide the frames */
#summary-scroll,
#reports-scroll,
#diff-scroll,
#stats-scroll {
    height: 1fr;
    background: $background;
    padding: 1 1 0 1;
}

#diff-view {
    height: 1fr;
    layout: vertical;
    padding: 1 1 0 1;
    background: $background;
}

#diff-chrome {
    height: 10;
    min-height: 8;
    layout: horizontal;
    background: $surface;
    border: solid $primary-background;
    margin: 0 0 1 0;
}

#diff-filter-bar {
    width: 28;
    min-width: 20;
    height: 1fr;
    layout: vertical;
    padding: 0 1;
    border: none;
    border-right: solid $primary-lighten-2;
    background: $surface;
}

#diff-filter-label {
    min-height: 1;
    height: auto;
    padding: 0 0 1 0;
}

#diff-point-select {
    width: 100%;
}

#diff-context {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    background: $surface;
    border: none;
    padding: 0;
    margin: 0;
}

#diff-context-tabs {
    height: 1fr;
}

#diff-context-tabs ContentSwitcher {
    height: 1fr;
    border-top: solid $primary-background;
}

#diff-context-tabs UnderlineTab.-active,
#diff-context-tabs Tab.-active {
    text-style: bold;
    color: $text;
    background: $primary 20%;
}

#diff-prompt-scroll,
#diff-assistant-scroll {
    height: 1fr;
    padding: 0 1;
}

#diff-search-bar {
    margin: 0 0 1 0;
}

#diff-search-bar Input {
    width: 1fr;
    height: auto;
    min-height: 3;
    border: solid $primary-background;
    padding: 0 1;
    background: $surface-darken-1;
    color: $text;
}

#diff-search-bar Input:focus {
    border: solid $accent;
    background: $surface;
}

#diff-layout {
    height: 1fr;
    layout: horizontal;
    background: $surface;
    border: solid $primary-background;
}

#diff-files {
    width: 36;
    min-width: 18;
    height: 1fr;
    padding: 0;
    border-right: solid $primary-lighten-2;
}

#diff-file-list {
    height: 1fr;
    min-height: 8;
    border: none;
    background: $surface-darken-1;
}

#diff-scroll {
    width: 1fr;
    height: 1fr;
    padding: 1;
    background: $background;
}

#browser-analysis-loading {
    display: none;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#findings-panel {
    height: 1fr;
    layout: vertical;
    padding: 1 1 0 1;
    background: $background;
}

/* Tables inside cards: no double outer border (card already frames) */
.summary-pair {
    height: auto;
    layout: horizontal;
}

.summary-pair > .panel-card {
    width: 1fr;
    margin: 0 1 1 0;
}

/* Narrow window: stack the pair instead of squeezing two tables. */
#summary-scroll.summary-stack .summary-pair {
    layout: vertical;
}

#summary-scroll.summary-stack .summary-pair > .panel-card {
    width: 100%;
    margin: 0 0 1 0;
}

.panel-card DataTable {
    height: auto;
    min-height: 5;
    max-height: 18;
    margin: 0;
    border: none;
    background: $surface-darken-1;
}

/* Same box as unfocused: a tall focus border shifts rows under the click. */
.panel-card DataTable:focus,
#findings-table:focus {
    border: none;
}

.panel-card DataTable:focus > .datatable--header,
#findings-table:focus > .datatable--header {
    background: $accent;
    color: $text;
}

#findings-table {
    height: 1fr;
    min-height: 8;
    border: none;
    background: $surface-darken-1;
}

/* Focused browser pane tab — accent from user theme (lazygit-style active edge) */
#browser-tabs UnderlineTab.-active,
#browser-tabs Tab.-active,
#runner-tabs UnderlineTab.-active,
#runner-tabs Tab.-active,
#pe-tabs UnderlineTab.-active,
#pe-tabs Tab.-active {
    text-style: bold;
    color: $text;
    background: $primary 20%;
}

#browser-tabs ContentSwitcher,
#runner-tabs ContentSwitcher {
    height: 1fr;
    border-top: solid $primary-background;
}

#detail-body {
    height: auto;
    padding: 1;
}

/* ── DataTable — zebra + frame (theme tokens; enable zebra_stripes in code) ─ */

DataTable {
    height: 1fr;
    background: $surface;
    color: $text;
    border: solid $primary-background;
}

/* Modal / embedded tables should not always eat 1fr */
#mcp-pick-table,
#plugins-pick-table,
#skills-pick-table,
#jobs-status-table,
#jobs-history-table,
#container-status-table,
#rule-table {
    height: auto;
    min-height: 6;
    max-height: 1fr;
}

DataTable > .datatable--header {
    background: $primary;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--header-cursor {
    background: $primary-lighten-1;
    text-style: bold;
}

/* Zebra: subtle alternation (only when zebra_stripes=True on the widget) */
DataTable > .datatable--odd-row {
    background: $surface;
}

DataTable > .datatable--even-row {
    background: $surface-darken-1;
}

DataTable > .datatable--cursor {
    background: $accent;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $primary 25%;
}

DataTable > .datatable--fixed {
    background: $panel;
}

/* ── Modals ───────────────────────────────────────────────────────────── */

ModalScreen {
    align: center middle;
}

/* Help modal styles: HelpModal.DEFAULT_CSS in widgets/help_modal.py */

#modal-container {
    width: 80;
    height: auto;
    max-height: 90%;
    layout: vertical;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#modal-container #flag-modal-body {
    height: 1fr;
    min-height: 4;
    overflow-y: auto;
    padding: 0 2;
}

#notes-modal-body SelectionList.note-field-choices {
    height: auto;
    max-height: 10;
    margin-bottom: 1;
}

#flag-buttons {
    dock: bottom;
    height: auto;
    min-height: 3;
    margin: 0;
    padding: 1 2;
    align: left middle;
    background: $surface;
}

#modal-container Button {
    margin: 0 1 0 0;
    height: 1;
}

/* Shared modal footer class (always visible action row) */
.modal-footer {
    dock: bottom;
    height: auto;
    min-height: 3;
    align: left middle;
    margin: 0;
    padding: 1 0;
    background: $surface;
}

/* ── Buttons — quiet terminal links/actions (avoid blocky "toggle" look) ─ */

Button {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
    margin: 0 1 0 0;
    background: transparent;
    color: $text;
    text-style: none;
}

Button:hover {
    color: $accent;
    background: transparent;
    text-style: underline;
}

Button:focus {
    background: $surface-lighten-1;
    text-style: none;
    color: $text;
}

/* Keyboard focus — visible for Tab navigation (AGENTS.md TUI patterns) */
DataTable:focus {
    border: tall $accent;
}

/* Do NOT apply to CommandPalette: Textual's CommandInput uses border: blank and
   a horizontal icon+input row; tall focus borders misalign the search popup. */
Input:focus,
TextArea:focus,
Checkbox:focus,
OptionList:focus {
    border: tall $accent;
}

CommandPalette Input,
CommandPalette Input:focus,
CommandPalette OptionList,
CommandPalette OptionList:focus {
    border: blank;
}

/* Select focus is on SelectCurrent (see Select rules above), not the outer widget */
Select:focus {
    border: none;
}


/* Real action buttons (toolbars, modals) — subtle pill, not a filled block */
#runner-toolbar Button,
#jobs-modal-actions Button,
#rc-actions Button,
#run-caps-actions Button,
#pb-actions Button,
#analysis-settings-actions Button,
#feedback-actions Button,
#modal-container Button,
#mcp-pick-search-row Button,
#mcp-pick-footer Button,
#skills-picker-modal Button,
#persona-editor-modal Button,
#personas-screen Button {
    background: $surface-lighten-1;
    color: $text;
    padding: 0 2;
}

#runner-toolbar Button:hover,
#jobs-modal-actions Button:hover,
#rc-actions Button:hover,
#run-caps-actions Button:hover,
#pb-actions Button:hover,
#analysis-settings-actions Button:hover,
#feedback-actions Button:hover,
#modal-container Button:hover,
#mcp-pick-search-row Button:hover,
#mcp-pick-footer Button:hover,
#skills-picker-modal Button:hover,
#persona-editor-modal Button:hover,
#personas-screen Button:hover {
    background: $boost;
    color: $text;
    text-style: none;
}

#runner-toolbar Button:focus,
#jobs-modal-actions Button:focus,
#rc-actions Button:focus,
#run-caps-actions Button:focus,
#pb-actions Button:focus,
#analysis-settings-actions Button:focus,
#feedback-actions Button:focus,
#modal-container Button:focus,
#mcp-pick-search-row Button:focus,
#mcp-pick-footer Button:focus,
#skills-picker-modal Button:focus,
#persona-editor-modal Button:focus,
#personas-screen Button:focus {
    background: $boost;
    text-style: bold;
}

Button.-primary {
    background: $primary-darken-2;
    color: $text;
    text-style: bold;
}

Button.-primary:hover {
    background: $primary;
    color: $text;
    text-style: bold;
}

Button.-primary:focus {
    background: $primary;
    text-style: bold;
}

/* Muted secondary actions on runner toolbar */
#runner-toolbar .runner-secondary-btn,
.runner-secondary-btn,
.runner-inline-btn {
    background: transparent;
    color: $text-muted;
}

#runner-toolbar .runner-secondary-btn:hover,
.runner-secondary-btn:hover,
.runner-inline-btn:hover {
    color: $text;
    background: $surface-lighten-1;
    text-style: none;
}

Button.-error {
    color: $error;
    background: transparent;
}

Button.-error:hover {
    background: $error-darken-2;
    color: $text;
}

Button:disabled {
    color: $text-muted;
    background: transparent;
    text-style: dim;
    opacity: 50%;
}

/* SelectionList: same cutout frame as Select overlays */
SelectionList {
    background: $boost !important;
    border: heavy #000000 !important;
    outline: tall $accent !important;
    padding: 1 2;
    background-tint: $foreground 0%;
}

SelectionList:focus {
    border: heavy #000000 !important;
    outline: wide $accent !important;
}

SelectionList > .selection-list--option {
    padding: 0 1;
}

SelectionList > .selection-list--option-highlighted {
    background: $accent !important;
    color: $background !important;
    text-style: bold;
}

/* ── Loading indicator ────────────────────────────────────────────────── */

LoadingIndicator {
    height: auto;
}

/* ── Utility ──────────────────────────────────────────────────────────── */

.hidden {
    display: none;
}

.text-error { color: $error; }
.text-warning { color: $warning; }
.text-success { color: $success; }
.text-muted { color: $text-muted; }
/* ── Run configs screen ──────────────────────────────────────────────── */
#rc-banner {
    padding: 1 2;
    height: auto;
}

#rc-selection-status {
    padding: 0 2 0 2;
    height: auto;
    color: $text-muted;
}

#rc-selection-tip {
    padding: 0 2 1 2;
    height: auto;
}

#rc-table {
    height: 1fr;
    min-height: 10;
    margin: 0 1;
}

#rc-detail {
    padding: 1 2;
    height: auto;
    max-height: 10;
    border-top: solid $primary-lighten-2;
}

#rc-actions {
    height: auto;
    padding: 1 2;
}

#rc-actions Button {
    margin-right: 1;
}

#models-override-modal {
    width: 70;
    height: auto;
    max-height: 90%;
    layout: vertical;
    padding: 1 2;
    border: heavy $primary;
    background: $surface;
}

#models-override-modal Input {
    margin: 1 0;
}

#batch-launch-modal {
    width: 76;
    height: auto;
    max-height: 90%;
    layout: vertical;
    padding: 1 2;
    border: heavy $warning;
    background: $surface;
}

#batch-launch-modal Input {
    margin: 1 0;
}

#batch-launch-modal Label {
    margin-top: 1;
}
